    <PackageReference Include="DevExpress.AspNetCore.Reporting" VersionOverride="25.2.4" />
    <PackageReference Include="DevExpress.Reporting.Demos" VersionOverride="25.2.4" />
    <PackageReference Include="DevExpress.Drawing.Skia" VersionOverride="25.2.4" />
