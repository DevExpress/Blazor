@using DevExpress.Blazor.Internal
@* @using BlazorDemo.DemoThemes *@
@inject DemoThemeService Themes

<li class="themeswitcher-color @Theme.Name @DemoTheme.GetCssClass(Themes.ActiveTheme == Theme) @GetThemeItemColorClassName(Theme.Name)">
    <a
        @onclick:preventDefault
        @onclick="Anchor_Click">@Theme.Title</a>
</li>

@code {
    [Parameter] public EventCallback<DemoTheme> Click { get; set; }
    [Parameter] public DemoTheme Theme { get; set; }

    async Task Anchor_Click() {
        await Click.InvokeAsync(Theme);
    }

    string GetActiveCssClass() {
        return Themes.ActiveTheme?.Name == Theme.Name ? "active" : null;
    }

    public static string GetThemeItemColorClassName(string theme) => $"theme-switcher-color-{theme}";
}
