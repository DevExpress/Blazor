<DemoPageSectionComponent Id="Navigation-Ribbon-Overview" ShowSizeMode="true">
    <ChildContentWithParameters Context="Params">
        <div class="ribbon-container">
            <DxRibbon SizeMode="@Params.SizeMode" ItemClick="OnRibbonItemClick" ApplicationTabItemClick="OnApplicationTabItemClick">
                <DxRibbonApplicationTab Text="File">
                    <DxRibbonApplicationTabItem Text="New"
                                                IconCssClass="rb-icon rb-icon-document-blank"/>
                    <DxRibbonApplicationTabItem Text="Open"
                                                IconCssClass="rb-icon rb-icon-folder-open"/>
                    <DxRibbonApplicationTabItem Text="Save as"
                                                IconCssClass="rb-icon rb-icon-save">
                        <DxRibbonApplicationTabItem Text="Plain Text" />
                        <DxRibbonApplicationTabItem Text="Word Document" />
                        <DxRibbonApplicationTabItem Text="PDF" />
                    </DxRibbonApplicationTabItem>
                    <DxRibbonApplicationTabItem Text="Share"
                                                IconCssClass="rb-icon rb-icon-share"/>
                    <DxRibbonApplicationTabItem Text="Print"
                                                IconCssClass="rb-icon rb-icon-print"/>
                </DxRibbonApplicationTab>
                <DxRibbonTab Text="Home">
                    <DxRibbonGroup Text="Mail">
                        <DxRibbonItem Text="New Mail"
                                      IconCssClass="rb-icon rb-icon-mail"
                                      SplitDropDownButton="true"
                                      IsPrimary="true"
                                      Tooltip="New Mail">
                            <DxRibbonItem Text="New Mail"
                                          IconCssClass="rb-icon rb-icon-mail"
                                          Tooltip="New Mail"/>
                            <DxRibbonItem Text="New Meeting"
                                          IconCssClass="rb-icon rb-icon-calendar-day"
                                          Tooltip="New Meeting"/>
                        </DxRibbonItem>
                        <DxRibbonItem Text="Delete"
                                      IconCssClass="rb-icon rb-icon-delete"
                                      Tooltip="Delete"/>
                        <DxRibbonItem Text="Archive"
                                      IconCssClass="rb-icon rb-icon-archive color-green"
                                      Tooltip="Archive"/>
                        <DxRibbonItem Text="Sweep"
                                      IconCssClass="rb-icon rb-icon-clear-history"
                                      Tooltip="Sweep"/>
                        <DxRibbonItem Text="Move to"
                                      IconCssClass="rb-icon rb-icon-folder-arrow-right color-blue"
                                      Tooltip="Move to"/>
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Tags">
                        <DxRibbonItem Text="Chat"
                                      IconCssClass="rb-icon rb-icon-chat"
                                      Tooltip="Chat">
                            <DxRibbonItem Text="Chat with all participants"
                                          IconCssClass="rb-icon rb-icon-chat"
                                          Tooltip="Chat with all participants"/>
                        </DxRibbonItem>
                        <DxRibbonItem Text="Categorize"
                                      IconCssClass="rb-icon rb-icon-tag"
                                      Tooltip="Categorize">
                            <DxRibbonItem Text="New category"
                                          Tooltip="New category"/>
                            <DxRibbonItem Text="Manage categories"
                                          Tooltip="Manage categories"/>
                        </DxRibbonItem>
                        <DxRibbonItem Text="Flag/Unflag"
                                      IconCssClass="rb-icon rb-icon-flag color-red"
                                      SplitDropDownButton="true"
                                      Tooltip="Flag/Unflag">
                            <DxRibbonItem Text="Today"
                                          Tooltip="Today"/>
                            <DxRibbonItem Text="Tomorrow"
                                          Tooltip="Tomorrow"/>
                            <DxRibbonItem Text="This week"
                                          Tooltip="This week"/>
                            <DxRibbonItem Text="Next week"
                                          Tooltip="Next week"/>
                            <DxRibbonItem Text="No date"
                                          Tooltip="No date"/>
                            <DxRibbonItem Text="Custom"
                                          Tooltip="Custom"/>
                        </DxRibbonItem>
                        <DxRibbonItem Text="Snooze"
                                      IconCssClass="rb-icon rb-icon-clock"
                                      Tooltip="Snooze"/>
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Print">
                        <DxRibbonItem Text="Print"
                                      IconCssClass="rb-icon rb-icon-print"
                                      Tooltip="Print"/>
                    </DxRibbonGroup>
                </DxRibbonTab>
                <DxRibbonTab Text="Edit">
                    <DxRibbonGroup>
                        <DxRibbonItem Text="Undo"
                                      IconCssClass="rb-icon rb-icon-undo"
                                      Tooltip="Undo"/>
                        <DxRibbonItem Text="Redo"
                                      IconCssClass="rb-icon rb-icon-redo"
                                      Tooltip="Redo"/>
                        <DxRibbonItem Text="Paste"
                                      IconCssClass="rb-icon rb-icon-paste"
                                      SplitDropDownButton="true"
                                      Tooltip="Paste">
                            <DxRibbonItem Text="Copy"
                                          IconCssClass="rb-icon rb-icon-copy"
                                          Tooltip="Copy"/>
                            <DxRibbonItem Text="Cut"
                                          IconCssClass="rb-icon rb-icon-cut"
                                          Tooltip="Cut"/>
                        </DxRibbonItem>
                        <DxRibbonItem Text="Paint format"
                                      IconCssClass="rb-icon rb-icon-paint"
                                      Tooltip="Paint format"/>
                    </DxRibbonGroup>
                    <DxRibbonGroup>
                        <DxRibbonComboBoxItem Data="Fonts"
                                              @bind-Value="CurrentFont"
                                              TextFieldName="@nameof(FontInfo.Name)"
                                              Width="120px" />
                        <DxRibbonComboBoxItem Data="FontSizes"
                                              @bind-Value="CurrentFontSize"
                                              TextFieldName="@nameof(FontSizeInfo.Size)"
                                              Width="65px" />
                    </DxRibbonGroup>
                    <DxRibbonGroup>
                        <DxRibbonToggleItem Text="Bold"
                                            @bind-Checked="BoldActive"
                                            IconCssClass="rb-icon rb-icon-bold"
                                            Tooltip="Bold"/>
                        <DxRibbonToggleItem Text="Italic"
                                            @bind-Checked="ItalicActive"
                                            IconCssClass="rb-icon rb-icon-italic"
                                            Tooltip="Italic"/>
                        <DxRibbonToggleItem Text="Underline"
                                            @bind-Checked="UnderlineActive"
                                            IconCssClass="rb-icon rb-icon-underline"
                                            Tooltip="Underline"/>
                        <DxRibbonColorPaletteItem Text="Font Color"
                                                  @bind-Value="color"
                                                  Tooltip="Font Color">
                            <IconTemplate>
                                @if(Themes.ActiveTheme.IsFluent) {
                                    <svg width="20" height="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                        <path fill="@color" d="M4.5 12C3.67157 12 3 12.6716 3 13.5V16.5C3 17.3284 3.67157 18 4.5 18H15.5C16.3284 18 17 17.3284 17 16.5V13.5C17 12.6716 16.3284 12 15.5 12H4.5Z" />
                                        <path d="M10.4642 2.3143C10.3883 2.12448 10.2045 2 10 2C9.79556 2 9.6117 2.12448 9.53577 2.3143L6.53577 9.8143C6.43322 10.0707 6.55792 10.3617 6.81432 10.4642C7.07071 10.5668 7.36169 10.4421 7.46425 10.1857L8.53707 7.50364H11.4629L12.5358 10.1857C12.6383 10.4421 12.9293 10.5668 13.1857 10.4642C13.4421 10.3617 13.5668 10.0707 13.4642 9.8143L10.4642 2.3143ZM10 3.84629L11.0629 6.50364H8.93707L10 3.84629Z" />
                                    </svg>
                                } else {
                                    <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 16 16" width="16" height="16">
                                        <path fill="currentColor" d="M2.66797 10.6667H4.65057L5.66797 8H10.3346L11.3521 10.6667H13.3346L9.02538 0H6.97725L2.66797 10.6667ZM6.0013 6.66667L8.0013 2L10.0013 6.66667H6.0013Z" />
                                        <path fill="@color" d="M1 13C1 12.4477 1.52233 12 2.16667 12H13.8333C14.4777 12 15 12.4477 15 13V15C15 15.5523 14.4777 16 13.8333 16H2.16667C1.52233 16 1 15.5523 1 15V13Z" />
                                    </svg>
                                }
                            </IconTemplate>
                        </DxRibbonColorPaletteItem>

                    </DxRibbonGroup>
                    <DxRibbonGroup>
                        <DxRibbonItem Text="Bullets"
                                      IconCssClass="rb-icon rb-icon-bullets"
                                      SplitDropDownButton="true"
                                      Tooltip="Bullets">
                            <DxRibbonItem Text="Numbering"
                                          Tooltip="Numbering"/>
                            <DxRibbonItem Text="Multilevel list"
                                          Tooltip="Multilevel list"/>
                        </DxRibbonItem>
                        <DxRibbonToggleGroup>
                            <DxRibbonToggleItem Text="Align Left"
                                                IconCssClass="rb-icon rb-icon-align-left"
                                                Tooltip="Align Left">
                            </DxRibbonToggleItem>
                            <DxRibbonToggleItem Text="Align Center"
                                                IconCssClass="rb-icon rb-icon-align-center"
                                                Tooltip="Align Center">
                            </DxRibbonToggleItem>
                            <DxRibbonToggleItem Text="Align Right"
                                                IconCssClass="rb-icon rb-icon-align-right"
                                                Tooltip="Align Right">
                            </DxRibbonToggleItem>
                        </DxRibbonToggleGroup>
                    </DxRibbonGroup>
                    <DxRibbonGroup>
                        <DxRibbonComboBoxItem Data="FontStyles"
                                              @bind-Value="FontStyle"
                                              Width="120px" />
                    </DxRibbonGroup>
                    <DxRibbonGroup>
                        <DxRibbonItem Text="Search"
                                      IconCssClass="rb-icon rb-icon-search"
                                      SplitDropDownButton="true"
                                      Tooltip="Search">
                            <DxRibbonItem Text="Replace"
                                          Tooltip="Replace"/>
                            <DxRibbonItem Text="Select"
                                          Tooltip="Select"/>
                        </DxRibbonItem>
                    </DxRibbonGroup>
                    <DxRibbonGroup>
                        <DxRibbonItem Text="Dictate"
                                      IconCssClass="rb-icon rb-icon-dictate"
                                      SplitDropDownButton="true"
                                      Tooltip="Dictate">
                            <DxRibbonItem Text="Transcribe"
                                          Tooltip="Transcribe"/>
                        </DxRibbonItem>
                        <DxRibbonItem Text="Settings"
                                      Tooltip="Settings"/>
                    </DxRibbonGroup>
                </DxRibbonTab>
                <DxRibbonTab Text="Insert" Contextual="true">
                    <DxRibbonGroup>
                        <DxRibbonItem Text="Page Break"
                                      IconCssClass="rb-icon rb-icon-page-break"
                                      Tooltip="Page Break"/>
                        <DxRibbonItem Text="Table"
                                      IconCssClass="rb-icon rb-icon-table"
                                      SplitDropDownButton="true"
                                      Tooltip="Table">
                            <DxRibbonItem Text="Insert Table..."
                                          Tooltip="Insert Table..."/>
                            <DxRibbonItem Text="Draw Table"
                                          Tooltip="Draw Table"/>
                        </DxRibbonItem>
                        <DxRibbonItem Text="Picture"
                                      IconCssClass="rb-icon rb-icon-picture"
                                      SplitDropDownButton="true"
                                      Tooltip="Picture">
                            <DxRibbonItem Text="This Device..."
                                          Tooltip="This Device..."/>
                            <DxRibbonItem Text="Stock Images..."
                                          Tooltip="Stock Images..."/>
                            <DxRibbonItem Text="Online Pictures..."
                                          Tooltip="Online Pictures..."/>
                        </DxRibbonItem>
                        <DxRibbonItem Text="Link"
                                      IconCssClass="rb-icon rb-icon-link"
                                      Tooltip="Link">
                        </DxRibbonItem>
                        <DxRibbonItem Text="Bookmark"
                                      IconCssClass="rb-icon rb-icon-bookmarks"
                                      Tooltip="Bookmark">
                        </DxRibbonItem>
                        <DxRibbonItem Text="Page Numbers"
                                      IconCssClass="rb-icon rb-icon-page-numbers"
                                      SplitDropDownButton="true"
                                      Tooltip="Page Numbers">
                            <DxRibbonItem Text="Format Page Numbers..."
                                          Tooltip="Format Page Numbers..."/>
                            <DxRibbonItem Text="Remove Page Numbers..."
                                          Tooltip="Remove Page Numbers..."/>
                        </DxRibbonItem>
                        <DxRibbonItem Text="Symbol"
                                      IconCssClass="rb-icon rb-icon-symbol"
                                      Tooltip="Symbol">
                        </DxRibbonItem>
                    </DxRibbonGroup>
                </DxRibbonTab>
            </DxRibbon>

            <DxToastProvider Name="RibbonOverview"
                             RenderStyle="ToastRenderStyle.Info"
                             ThemeMode="ToastThemeMode.Pastel"
                             HorizontalAlignment="HorizontalAlignment.Center"
                             VerticalAlignment="VerticalEdge.Bottom"
                             DisplayTime="TimeSpan.FromSeconds(2)"
                             MaxToastCount="1" />
        </div>
    </ChildContentWithParameters>
    @code {
        [Inject] private IToastNotificationService ToastService { get; set; }
        [Inject] private DemoThemeService Themes { get; set; }
        string color = "Red";

        private FontInfo CurrentFont { get; set; } = FontInfo.DefaultFonts[0];
        private IEnumerable<FontInfo> Fonts => FontInfo.DefaultFonts;

        private FontSizeInfo CurrentFontSize { get; set; } = FontSizeInfo.DefaultFontSizes[0];
        private IEnumerable<FontSizeInfo> FontSizes => FontSizeInfo.DefaultFontSizes;

        private string FontStyle { get; set; }
        private string[] FontStyles { get; set; } = [
        "Normal", "Header 1", "Header 2", "Title"
        ];
        private bool UnderlineActive { get; set; }
        private bool BoldActive { get; set; }
        private bool ItalicActive { get; set; }

        void ShowToast(string name) {
            ToastService.ShowToast(new ToastOptions {
                ProviderName = "RibbonOverview",
                Text = "Clicked: " + name,
            });
        }
        void OnApplicationTabItemClick(RibbonApplicationTabItemClickEventArgs args) {
            ShowToast(args.Item.Text);
        }
        void OnRibbonItemClick(RibbonItemClickEventArgs args) {
            ShowToast(args.Item.Text);
        }
    }
</DemoPageSectionComponent>

@code {
    public override Task SetParametersAsync(ParameterView parameters) {
        FontStyle = FontStyles[0];
        return base.SetParametersAsync(parameters);
    }
}
