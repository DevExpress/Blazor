@using DevExpress.AIIntegration.Blazor.Chat
@using System.Text.Json;
@using System.Reflection;
@using System.IO;

@inject HttpClient httpClient;
@inject NavigationManager NavigationManager;

<DemoPageSectionComponent Id="AIChat-FileAttachments"
ShowSizeMode="true">
    <OptionsContent>
        <OptionComboBox Label="File Types:" Data="Enum.GetValues<FileTypes>()" @bind-Value="@SelectedFileType" />
        <OptionCheckBox Label="Use Streaming" @bind-Checked="UseStreaming" />
    </OptionsContent>
    <ChildContentWithParameters Context="Params">
        <div class="chat-demo-container">
            <DxAIChat FileUploadEnabled="true" CssClass="demo-chat" Initialized="ChatInitialized" UseStreaming="UseStreaming" SizeMode="Params.SizeMode">
                <AIChatSettings>
                    <DxAIChatFileUploadSettings MaxFileSize="10000000" MaxFileCount="3" AllowedFileExtensions="@Extensions[SelectedFileType]" FileTypeFilter="@Types[SelectedFileType]" />
                </AIChatSettings>
                <MessageTemplate>
                    <div class="@GetMessageClasses(context)">
                        @if (context.Typing) {
                            <span>Loading...</span>
                        } else {
                            <div class="demo-chat-content">
                                @if (context.Files != null && context.Files.Count > 0) {
                                    <div class="demo-chat-file-list">
                                        @foreach (var file in context.Files) {
                                            var isImage = Extensions[FileTypes.Images].Contains(Path.GetExtension(file.Name));

                                            @if (isImage) {
                                                <div class="demo-chat-file-base custom-preview">
                                                    <img src="@GetImageSrc(file)" class="demo-chat-file-preview" alt="@file.Name" />
                                                    <div class="demo-chat-file-preview-title demo-chat-file-name">
                                                        <span>@file.Name</span>
                                                    </div>
                                                </div>
                                            } else {
                                                <div class="demo-chat-file-base default-preview">
                                                    <div class="demo-chat-file-icon-container">
                                                        <img src="@StaticAssetUtils.GetImagePath("icons/file.svg")" class="demo-chat-file-icon" />
                                                    </div>
                                                    <span class="demo-chat-file-name">@file.Name</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                                @context.Content
                            </div>
                        }
                    </div>
                </MessageTemplate>
            </DxAIChat>
            <div class="chat-demo-alert" role="alert">
                AI services used in this demo are powered by GPT-4o-mini. This service currently supports image files only. The demo cannot process other file types (such as PDFs, text documents, or spreadsheets). To unlock support for additional file formats, connect the application to a compatible AI model or service.
            </div>
        </div>
        @code {
            const string IMAGE_NAME = "Eiffel-Tower.jpg";

            bool UseStreaming { get; set; } = false;
            FileTypes SelectedFileType = FileTypes.Images;

            public enum FileTypes {
                Images,
                Documents,
                Tables,
            }

            Dictionary<FileTypes, List<string>> Extensions = new Dictionary<FileTypes, List<string>>() {
                { FileTypes.Images, new List<string> { ".jpg", ".png", ".jpeg" } },
                { FileTypes.Documents, new List<string> { ".pdf", ".docx" } },
                { FileTypes.Tables, new List<string> { ".xlsx", ".csv" } },
            };

            Dictionary<FileTypes, List<string>> Types = new Dictionary<FileTypes, List<string>>() {
                { FileTypes.Images, new List<string> { "image/jpeg", "image/png" } },
                { FileTypes.Documents, new List<string> { "application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document" } },
                { FileTypes.Tables, new List<string> { "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "text/csv" } },
            };

            async void ChatInitialized(IAIChat chat) {
            var fileBytes = await httpClient.GetByteArrayAsync(NavigationManager.ToAbsoluteUri(StaticAssetUtils.GetImagePath($"/{IMAGE_NAME}")));
                var testFiles = new List<AIChatUploadFileInfo> {
                    new AIChatUploadFileInfo(
                        name: IMAGE_NAME,
                        type: "image/jpeg",
                        size: fileBytes.Length,
                        data: new ReadOnlyMemory<byte>(fileBytes)
                    )
                };

                chat.LoadMessages(new[] {
                    new BlazorChatMessage(Microsoft.Extensions.AI.ChatRole.User, "Analyze the image file and summarize its content." , testFiles),
                    new BlazorChatMessage(Microsoft.Extensions.AI.ChatRole.Assistant, "The image features the Eiffel Tower, a renowned landmark located in Paris, France. The tower is shown from a low angle, emphasizing its height and intricate iron lattice structure. The sky is lit with dramatic clouds and warm hues of sunset, creating a visually striking backdrop for the iconic monument. The overall scene conveys a sense of grandeur and beauty, highlighting the Eiffel Tower as a symbol of romance and architectural achievement.")
                });
            }

            private string GetImageSrc(AIChatUploadFileInfo file) {
                var base64 = Convert.ToBase64String(file.Data.ToArray());
                return $"data:{file.Type};base64,{base64}";
            }

            string GetMessageClasses(BlazorChatMessage message) {
                if (message.Role == ChatMessageRole.Assistant) {
                    return "demo-chat-message demo-assistant-message";
                } else if (message.Role == ChatMessageRole.User) {
                    return "demo-chat-message demo-user-message";
                } else if (message.Role == ChatMessageRole.Error) {
                    return "demo-chat-message demo-error-message";
                }
                return "demo-chat-message";
            }
        }
    </ChildContentWithParameters>
</DemoPageSectionComponent>
