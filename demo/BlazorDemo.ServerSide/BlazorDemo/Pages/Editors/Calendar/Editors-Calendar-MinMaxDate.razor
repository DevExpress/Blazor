<DemoPageSectionComponent Id="Editors-Calendar-MinMaxDate" ShowSizeMode="true">
    <ChildContentWithParameters Context="Params">
        <DxCalendar @bind-SelectedDate="@SelectedDate" 
                    MinDate="@MinDate" 
                    MaxDate="@MaxDate" 
                    SizeMode="Params.SizeMode" 
                    CssClass="demo-calendar" />
        <p class="demo-text cw-320 mt-3">
            Selected date: <b>@SelectedDate.ToString("dddd, MMMM dd, yyyy")</b>
        </p>
    </ChildContentWithParameters>

    @code {
        DateTime MinDate { get; set; }
        DateTime MaxDate { get; set; }

        DateTime SelectedDate { get; set; } = DateTime.Today;

        protected override void OnInitialized() {
            DateTime currentDateTime = DateTime.Now;

            MinDate = new DateTime(currentDateTime.Year, currentDateTime.Month, 1);
            MaxDate = new DateTime(
                currentDateTime.Year,
                currentDateTime.Month,
                DateTime.DaysInMonth(currentDateTime.Year, currentDateTime.Month)
            );
        }
    }
</DemoPageSectionComponent>
