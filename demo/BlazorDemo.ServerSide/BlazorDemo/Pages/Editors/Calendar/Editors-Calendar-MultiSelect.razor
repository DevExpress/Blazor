<DemoPageSectionComponent Id="Editors-Calendar-MultiSelect" ShowSizeMode="true">
    <ChildContentWithParameters Context="Params">
        <DxCalendar EnableMultiSelect="true" 
                    @bind-SelectedDates="@SelectedDates" 
                    SizeMode="Params.SizeMode" 
                    CssClass="demo-calendar" />
        <p class="demo-text cw-320 mt-3">
            Number of selected dates: <b>@SelectedDates.Count()</b>
        </p>
    </ChildContentWithParameters>

    @code {
        public IEnumerable<DateTime> SelectedDates { get; set; }
        IEnumerable<DateTime> GetSelectedDates() {
            DateTime baseDate = DateTime.Today;

            return new List<DateTime>() {
                baseDate.AddDays(-9),
                baseDate.AddDays(-5),
                baseDate.AddDays(-4),
                baseDate.AddDays(6),
                baseDate.AddDays(12),
                baseDate.AddDays(13),
                baseDate.AddDays(15)
            };
        }

        protected override void OnInitialized() {
            SelectedDates = GetSelectedDates();
        }
    }
</DemoPageSectionComponent>
