<DemoPageSectionComponent Id="FileManagement-Upload-Validation">
    @inject NavigationManager NavigationManager

    <div class="upload-container">
        <div class="@(SelectedFilesCount > 0 ? "d-none" : null)">
            <span class="drop-file-icon mb-3"></span>
            <span class="drop-file-label mb-3">Click the button below to start your upload</span>
        </div>
        <DxUpload Name="myFile"
                  MaxFileSize="4000000"
                  AllowedFileExtensions="@(new List<string> { ".jpg", ".jpeg", ".gif", ".png" })"
                  UploadUrl="@GetUploadUrl("api/UploadValidation/Upload/")"
                  SelectedFilesChanged="@SelectedFilesChanged">
        </DxUpload>
    </div>
    <div class="upload-validation-text info-text">
        <span>Uploads are limited to a single file up to 15 MB.</span>
        <span>Allowed file extensions: .jpg, .jpeg, .gif, .png.</span>
    </div>

    @code {
        int SelectedFilesCount { get; set; }

        protected void SelectedFilesChanged(IEnumerable<UploadFileInfo> files) {
            SelectedFilesCount = files.ToList().Count;

            InvokeAsync(StateHasChanged);
        }
        protected string GetUploadUrl(string url) {
            return NavigationManager.ToAbsoluteUri(url).AbsoluteUri;
        }
    }
</DemoPageSectionComponent>
