@inject ICspNonceService NonceProvider
<DemoPageSectionComponent Id="Editors-Calendar-Overview" ShowSizeMode="true">
    <ChildContentWithParameters Context="Params">
        <DxCalendar @bind-SelectedDate="@SelectedDate" 
                    SizeMode="Params.SizeMode" 
                    CssClass="demo-calendar" />

        <p class="demo-text cw-320 mt-3">
            Selected date: <b>@SelectedDate.ToString("dddd, MMMM dd, yyyy")</b>
        </p>
    </ChildContentWithParameters>
    @code {
        DateTime SelectedDate { get; set; } = DateTime.Today;
    }
</DemoPageSectionComponent>

