@using DevExpress.Blazor.Internal

<DxScrollViewer CssClass="@($"{CssClass} blazor-scroll-view")" VisibleElementOid="@VisibleElementOid" VisibleElementVerticalAlign="@VerticalAlign.Top">
    @ChildContent
</DxScrollViewer>

@code {
    [Parameter]
    public string VisibleElementOid { get; set; }
    [Parameter]
    public string CssClass { get; set; }
    [Parameter]
    public RenderFragment ChildContent { get; set; }
}
